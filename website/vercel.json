{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tebpestcontrol.com" }],
      "destination": "https://tebpestcontrol.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [{ "source": "/((?!api|uploads).*)", "destination": "/index.html" }]
}
